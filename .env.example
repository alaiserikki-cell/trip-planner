# Copy this file to .env.local and fill in the keys. Never commit .env.local.
# Everything works without keys (offline planner, gradient covers, in-memory
# store) so you can try the full flow first, but nothing is saved and options
# come from a small built-in catalogue until you add them.

# --- Gemini ---
# Turns everyone's constraints and free-text answers into 3 trip options,
# writes each person's fit sentence, and builds round 2 from the votes.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash.
GEMINI_MODEL=

# --- Unsplash ---
# One cover photo per destination. Create an app at
# https://unsplash.com/oauth/applications and use its Access Key.
UNSPLASH_ACCESS_KEY=

# --- Supabase ---
# Stores trips, members, preferences, constraints, options, fit scores, votes
# and the locked trip. Run supabase/schema.sql in the SQL editor first.
# Project settings > API. The service-role key is only ever used server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
